<smil>
    <head>
        <meta http-equiv="Refresh" content="15" onlySmilUpdate="true"/>
        <meta log="false"/>
        <layout>
            <root-layout width="1920" height="1080" backgroundColor="#000000"/>
            <region regionName="cl2q7jqlu15755811xklizc1al4d" left="0" top="0" width="1920" height="1080" z-index="1"
                    backgroundColor="#000000">
                <region regionName="fullScreenTrigger" left="0" top="0" width="1920" height="1080" z-index="1"
                        backgroundColor="#000000" sync="true"/>
            </region>
        </layout>
    </head>
    <body>
        <par>
            <seq end="__prefetchEnd.endEvent">
                <seq repeatCount="indefinite">
                    <img src="http://localhost:3000/assets/content-downloading-landscape.jpeg" dur="5s" fit="fill"/>
                </seq>
            </seq>
            <seq>
                <prefetch src="http://localhost:3000/assets/img_3.jpg"/>
                <prefetch src="http://localhost:3000/assets/landscape1.jpg"/>
                <prefetch src="http://localhost:3000/assets/landscape2.jpg"/>
                <prefetch src="http://localhost:3000/assets/img_5.jpg"/>
                <seq id="__prefetchEnd" dur="1s"/>
            </seq>
            <par begin="__prefetchEnd.endEvent" repeatCount="indefinite">
                <!-- Campaign playlist -->
                <excl>
                    <par>
                        <seq repeatCount="indefinite">
                            <seq>
                                <img src="http://localhost:3000/assets/img_3.jpg" region="cl2q7jqlu15755811xklizc1al4d" dur="4s"/>
                            </seq>
                            <seq>
                                <img src="http://localhost:3000/assets/landscape1.jpg" region="cl2q7jqlu15755811xklizc1al4d" dur="4s"/>
                            </seq>
                            <seq>
                                <img src="http://localhost:3000/assets/landscape2.jpg" region="cl2q7jqlu15755811xklizc1al4d" dur="4s"/>
                            </seq>
                        </seq>
                    </par>
                </excl>
                <!-- Synchronization campaign playlist -->
                <par>
                    <!-- [GalleryModule] sync gallery 1-2 -->
                    <seq repeatCount="1" begin="dynamic_clh0lowq665961xm36si3kdui" end="dynamic2">
                        <img src="http://localhost:3000/assets/img_5.jpg" region="cl2q7jqlu15755811xklizc1al4d" dur="6s"/>
                    </seq>
                </par>
            </par>
        </par>
    </body>
</smil>
