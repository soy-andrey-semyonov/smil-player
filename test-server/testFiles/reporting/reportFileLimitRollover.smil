<smil>
    <head>
        <meta http-equiv="Refresh" content="90"/>
        <!-- reportFileLimit=2: the 3rd accumulated report rolls over to a new file -->
        <meta log="true" type="manual" endpoint="http://localhost:3000/report" reportFileLimit="2"/>
        <layout>
            <root-layout width="1080" height="1920"/>
            <region regionName="main" left="0" top="0" width="1920" height="1080" z-index="1"/>
        </layout>
    </head>
    <body>
        <par repeatCount="indefinite">
            <seq repeatCount="indefinite">
                <!-- both batch so every playback report accumulates in offline storage -->
                <img dur="2s"
                     src="http://localhost:3000/assets/landscape1.jpg"
                     region="main" fit="fill"
                     reportMode="batch"
                     popName="batchImage1" popType="image"
                     popTags="b1,b2"/>
                <img dur="2s"
                     src="http://localhost:3000/assets/landscape2.jpg"
                     region="main" fit="fill"
                     reportMode="batch"
                     popName="batchImage2" popType="image"
                     popTags="b3,b4"/>
            </seq>
        </par>
    </body>
</smil>
